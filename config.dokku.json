{
  "targetRepoPath": "/data/offline-tarteel",
  "targetRepoUrl": "git@github.com:yazinsai/offline-tarteel.git",
  "baseBranch": "main",
  "models": {
    "planner": "gpt-5.5",
    "worker": "gpt-5.5",
    "judge": "gpt-5.5"
  },
  "model": "default",
  "mode": "local",
  "maxConcurrentWorkers": 3,
  "maxConcurrentEvaluations": 1,
  "minQueuedTasks": 2,
  "staleWorkerMinutes": 30,
  "statePath": "/data/agent-farm/state.json",
  "promotion": {
    "baseBranch": "agent-farm/base",
    "minV3Delta": 0.03,
    "autoPromote": true
  },
  "baselineReports": {
    "v2": "web/frontend/test/stab-gate-on-v2.json",
    "v3": "web/frontend/test/stab-gate-on-v3.json"
  },
  "evaluation": {
    "targetSeqAcc": 0.9,
    "minPrecision": 0.72,
    "v2SeqAccRegressionTolerance": 0.01,
    "includeV2Gate": false,
    "remoteBackend": "modal",
    "parallelShards": 8,
    "cpuLimitPercent": 70,
    "modal": {
      "cpu": 4,
      "memoryMb": 8192,
      "image": "node:22-bookworm",
      "maxAttempts": 3
    },
    "devCorpus": "test_corpus_v3_dev",
    "devSampleLimit": 12,
    "holdoutCorpus": "test_corpus_v3_holdout",
    "fullCorpus": "test_corpus_v3",
    "repeatsDev": 1,
    "repeatsGate": 1,
    "repeatsFinal": 1
  }
}
